<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        DEVIATIONS.md D-005. §18.6 requires HTTPS only and usesCleartextTraffic="false".
        Local testing runs the phone against the development machine over office WiFi, where
        there is no certificate to trust.

        This exemption exists in the STAGING flavor only. The production manifest keeps
        cleartext disabled and ships no custom trust anchor, so no production build can ever
        inherit this relaxation.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>

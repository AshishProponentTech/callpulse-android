<?xml version="1.0" encoding="utf-8"?>
<!--
    STAGING FLAVOR ONLY — see DEVIATIONS.md D-005.

    This previously pinned the development machine's LAN address. That broke the moment DHCP
    moved the machine (192.168.1.20 -> .45), which on a dev laptop is routine rather than rare.

    Staging is a debug-only build that never reaches an employee, so it permits cleartext
    generally instead of chasing a moving IP. The safety property that actually matters is
    preserved structurally: this file exists ONLY in src/staging, so no production build can
    inherit it. Production keeps usesCleartextTraffic="false", ships no custom trust anchor,
    and is unaffected by anything here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
